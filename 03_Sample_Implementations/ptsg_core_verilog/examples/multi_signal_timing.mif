-- multi_signal_timing.mif — walking-ones across four timing signals
DEPTH = 256;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;
CONTENT BEGIN
0 : 00010021;   -- Stay 2, timing_signals = 0x0001
1 : 00020021;   -- Stay 2, timing_signals = 0x0002
2 : 00040021;   -- Stay 2, timing_signals = 0x0004
3 : 00080021;   -- Stay 2, timing_signals = 0x0008
4 : 00000000;   -- Reset (repeat)
[5..FF] : 00000000;
END;
