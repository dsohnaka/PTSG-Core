-- conditional_branching.mif — wait for Condition, pulse, restart
DEPTH = 256;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;
CONTENT BEGIN
0 : 00000002;   -- Branch operand 0 (wait for Condition)
1 : 00FF0700;   -- NOP timing_signals = 0x00FF (action pulse)
2 : 00000000;   -- Reset (wait again)
[3..FF] : 00000000;
END;
