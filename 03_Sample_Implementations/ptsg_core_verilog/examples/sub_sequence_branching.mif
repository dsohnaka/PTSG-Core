-- sub_sequence_branching.mif — Sub-sequence Call + Return
DEPTH = 256;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;
CONTENT BEGIN
0 : 00010700;   -- NOP timing_signals = 0x0001 (main line)
1 : 00040400;   -- Call offset 4 -> state 5 (save addr 1)
2 : 00020700;   -- NOP timing_signals = 0x0002 (return-to-after lands here)
3 : 00000000;   -- Reset (restart demo)
4 : 00000043;   -- Jump 4 (padding / halt)
5 : 00F00700;   -- NOP timing_signals = 0x00F0 (subroutine body)
6 : 00000300;   -- Return (-> state 2)
[7..FF] : 00000000;
END;
