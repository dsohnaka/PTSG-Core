// sub_sequence_branching — Sub-sequence Call + Return (auto-save / return-to-after)
// State table:
//   0: Global NOP, timing_signals = 0x0001 (main line)
//   1: Sub-sequence Call, offset 4 (D16-D31 = 4) -> jump to state 5, save addr 1
//   2: Global NOP, timing_signals = 0x0002 (return lands here: saved 1, +1 = 2)
//   3: Global Reset (restart the demo)
//   4: Jump 4 (padding / unreachable halt)
//   5: Global NOP, timing_signals = 0x00F0 (subroutine body)
//   6: Global Return (restore -> state 2)
00010700
00040400
00020700
00000000
00000043
00F00700
00000300
