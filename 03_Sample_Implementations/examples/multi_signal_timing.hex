// multi_signal_timing — walking-ones across four timing signals
// Each Stay holds its own timing_signals value for 2 clocks (×PRESCALE).
// State table:
//   0: Stay 2, timing_signals = 0x0001
//   1: Stay 2, timing_signals = 0x0002
//   2: Stay 2, timing_signals = 0x0004
//   3: Stay 2, timing_signals = 0x0008
//   4: Global Reset (repeat)
00010021
00020021
00040021
00080021
00000000
