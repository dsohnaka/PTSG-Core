// blinky_with_prescaler — LED blink at human-visible rate
// Intended core parameter: PRESCALE = 50000 (with a 50 MHz clk => 1 stay tick
// per 1 ms; Stay 500 => 0.5 s on, 0.5 s off).
// State table:
//   0: Global NOP, timing_signals = 0x0001 (LED on)
//   1: Stay 500          (hold on  for 500 prescaled ticks)
//   2: Global NOP, timing_signals = 0x0000 (LED off)
//   3: Stay 500          (hold off for 500 prescaled ticks)
//   4: Jump 1            (loop forever)
00010700
00011F41
00000700
00001F41
00000013
