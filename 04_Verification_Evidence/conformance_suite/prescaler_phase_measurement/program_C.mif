-- prescaler_phase_measurement — idiom C: NOP@2 ON + D17 boundary flags on NOP@2/Jump@4 -> 30:30 (flagged)
-- Core parameter for this measurement: PRESCALE = 5.
-- Silicon-verified on DE10-nano (SignalTap, 2026-06-22).
DEPTH = 256;
WIDTH = 32;
ADDRESS_RADIX = HEX;
DATA_RADIX = HEX;
CONTENT BEGIN
0 : 00010700;   -- Global/NOP  timing_signals=0x0001
1 : 00010051;   -- Stay 5  timing_signals=0x0001
2 : 00030700;   -- Global/NOP  timing_signals=0x0003
3 : 00000051;   -- Stay 5  timing_signals=0x0000
4 : 00020013;   -- Jump 1  timing_signals=0x0002
[5..FF] : 00000000;
END;
